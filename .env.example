# GitHubのActions Secret（値は公開リポジトリへ絶対に書かない）
DISCORD_WEBHOOK_URL=

# GitHubのRepository variables（未設定時は右記の既定値）
MOMENTUM_THRESHOLD=150
COOLDOWN_HOURS=12
ERROR_NOTIFY_COOLDOWN_HOURS=6
HEARTBEAT_DAYS=7

# 14082684は初期ブロックリストへ登録済み。ここには追加分を指定する。
# カンマ・空白・改行区切り。MixChannelの配信URLでも指定可能。
BLOCKED_USER_IDS=

# 通常は変更不要。主サイトを取得・解析できない場合に使う同系列の代替サイト。
FALLBACK_MONITOR_URL=https://ikioi-ranking.com/v/mixch
